# Copie para .env e substitua a senha antes de iniciar. Nao use aspas.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clicklance
DB_USER=clicklance
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
SERVER_PORT=8080

# Buckets privados ja autorizados pela plataforma, separados por virgula.
# Vazio impede provisionamento (503); nao cria bucket nem concede acesso AWS.
DEVICE_ALLOWED_BUCKETS=

# SDK S3 somente leitura; credenciais pela cadeia padrao AWS (perfil/IAM/ambiente).
AWS_REGION=us-east-1
# Opcional somente para endpoint S3 controlado pelo operador; nunca vem do payload.
STORAGE_ENDPOINT=

# Gere o par RSA com tools/GenerateAdminKeys.java antes de habilitar administracao.
# ADMIN_JWT_PRIVATE_KEY_PATH=.local-secrets/admin-private.pem
# ADMIN_JWT_PUBLIC_KEY_PATH=.local-secrets/admin-public.pem
