# ClickLance: uma camera/quadra por instancia do gateway.
# Copie para .env; nunca versione credenciais reais.
SERIAL_PORT=COM6
BAUD_RATE=9600
CAMERA_DEVICE_NAME=USB Video Device

# Backend: duracao 1..60, quantidade 1..300, produto ate 600 segundos.
# O backend e a fonte da duracao/quantidade; estes valores validam o bootstrap.
# Sugestao para piloto: configurar 10 segundos x 12 segmentos no backend.
SEGMENT_DURATION_SECONDS=60
SEGMENTS_TO_CONCAT=2
SEGMENTS_DIR=segments
RETENTION_HOURS=6
OUTPUT_DIR=clips
CLIP_AFTER_SECONDS=0.2
COOLDOWN_SECONDS=5
MIN_FREE_DISK_MB=512
MAX_PENDING_EVENTS=2000
STATE_DB=state/events.sqlite3
CONFIG_CACHE=state/config.json

API_BASE_URL=http://localhost:8080/api/v1
# Nao reutilize o antigo API_URL=/api/replays. Omita API_URL para derivacao automatica.
DISPOSITIVO_ID=disp_001
DEVICE_TOKEN=preencha_o_token_retornado_uma_vez_no_cadastro
# QUADRA_ID e resolvido pela configuracao autenticada; nao precisa ser declarado.

AWS_ACCESS_KEY_ID=preencha_a_chave_iam_de_upload
AWS_SECRET_ACCESS_KEY=preencha_o_segredo
# Para credenciais temporarias, preencher tambem AWS_SESSION_TOKEN.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=nome-do-bucket-privado
# Opcional: endpoint S3 compativel para ambiente de desenvolvimento.
S3_ENDPOINT_URL=

# Backup: use manage_events.py --backup para snapshot WAL consistente.
# Consulte README para salvar clipes/segmentos juntos e calibrar camera/clock.
