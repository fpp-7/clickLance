# ============================================
# Configuração do Equipamento Local (Edge PC)
# Copie este arquivo para .env e preencha.
# ============================================

# --- Serial (Arduino) ---
SERIAL_PORT=COM6
BAUD_RATE=9600

# --- DVR / Gravação Contínua ---
# Nome do dispositivo de vídeo (DirectShow no Windows).
# Para listar dispositivos disponíveis, rode:
#   ffmpeg -list_devices true -f dshow -i dummy
CAMERA_DEVICE_NAME=USB Video Device
## Produção: câmera IP. Modelo informado: Intelbras VIP, modelo exato pendente.
CAMERA_SOURCE=rtsp
# Preencha localmente com o stream confirmado; não versionar credenciais.
CAMERA_RTSP_URL=
CAMERA_RTSP_TRANSPORT=tcp
CAMERA_TIMEOUT_SECONDS=10
KEYFRAME_INTERVAL=30
# Latência medida entre cena e recepção; vazio bloqueia cliques RTSP.
# Não preencher zero sem medir a câmera e a rede.
CAMERA_LATENCY_SECONDS=
# Para a antiga webcam de teste, selecione CAMERA_SOURCE=dshow.
SEGMENT_DURATION_SECONDS=60
SEGMENTS_DIR=segments
# Retenção: segmentos mais antigos que este valor (em horas) serão apagados.
RETENTION_HOURS=6

# --- Processamento de Vídeo ---
# Quantos segmentos anteriores ao clique devem ser concatenados no lance.
SEGMENTS_TO_CONCAT=2
REPLAY_BEFORE_SECONDS=120
REPLAY_AFTER_SECONDS=0
REPLAY_WAIT_SECONDS=65
REPLAY_FFMPEG_TIMEOUT_SECONDS=180
OUTPUT_DIR=clips

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=sua_aws_access_key
AWS_SECRET_ACCESS_KEY=sua_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=nome-do-seu-bucket

# --- API Backend (Spring Boot) ---
API_URL=http://localhost:8080/api/replays
QUADRA_ID=quadra_001
