# Modo da camada de API: "mock" (dados fictícios, sem backend) ou "http" (API real)
NEXT_PUBLIC_API_MODE=mock

# URL base da API real. Só é usada quando NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# URL pública do site. Usada para montar links de compartilhamento e metatags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Latência simulada do mock, em milissegundos (0 para respostas instantâneas)
NEXT_PUBLIC_MOCK_LATENCIA=450
