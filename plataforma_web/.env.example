# "mock": demonstracao explicita com estado em memoria. "http": API real via BFF.
NEXT_PUBLIC_API_MODE=mock

# Origem privada do Spring Boot (sem /api/v1). Nunca usar NEXT_PUBLIC_ para segredos.
# O navegador chama /api/backend; apenas o servidor Next se conecta ao backend.
BACKEND_URL=http://127.0.0.1:8080

# URL pública do site. Usada para montar links de compartilhamento e metatags
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Em producao, publicar sob HTTPS para enviar os cookies Secure de sessao.
